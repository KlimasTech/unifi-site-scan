<script>
(function () {
  var USS = {
    selectedSites: <?=json_encode(array_values($selectedSites))?>,
    selectedSsids: <?=json_encode(array_values($selectedSsids))?>,
    csrfToken: <?=json_encode($csrfToken)?>,
    scanUrl: '/plugins/unifi-site-scan/scripts/scan.php',
    saveUrl: '/plugins/unifi-site-scan/scripts/save.php',
  };

  function $(id) { return document.getElementById(id); }

  // Bezpieczny fetch->JSON: jeśli serwer nie zwróci poprawnego JSON (np.
  // przekierowanie do loginu po wygaśnięciu sesji, 403 CSRF), pokazuje
  // dokładny status/treść zamiast kryptycznego "Unexpected end of JSON input".
  function ussFetchJson(url, opts) {
    opts = opts || {};
    // webGUI (auto_prepend_file) wymaga tokena CSRF dla kazdego POST - przy JSON body
    // $_POST jest puste, wiec token trzeba wyslac jako naglowek X-Csrf-Token.
    if ((opts.method || 'GET').toUpperCase() === 'POST') {
      opts.headers = Object.assign({ 'X-Csrf-Token': USS.csrfToken }, opts.headers || {});
    }
    return fetch(url, opts).then(function (r) {
      return r.text().then(function (text) {
        if (!text) {
          throw new Error('Pusta odpowiedź serwera (HTTP ' + r.status + '). Sesja WebGUI mogła wygasnąć — odśwież stronę i zaloguj się ponownie.');
        }
        try {
          return JSON.parse(text);
        } catch (e) {
          if (text.trim().charAt(0) === '<') {
            throw new Error('Serwer zwrócił stronę HTML zamiast danych (HTTP ' + r.status + ') — prawdopodobnie wygasła sesja WebGUI. Odśwież stronę i zaloguj się ponownie.');
          }
          throw new Error('Nieprawidłowa odpowiedź serwera (HTTP ' + r.status + '): ' + text.slice(0, 200));
        }
      });
    });
  }

  function showStatus(el, ok, msg) {
    el.className = 'uss-status ' + (ok ? 'ok' : 'err');
    el.textContent = msg;
  }

  // --- Zapis połączenia ---
  $('uss-save').addEventListener('click', function () {
    var payload = {
      host: $('uss-host').value.trim(),
      port: $('uss-port').value.trim() || '8443',
      username: $('uss-username').value.trim(),
      password: $('uss-password').value,
      apikey: $('uss-apikey').value.trim(),
      csrf_token: USS.csrfToken,
    };
    ussFetchJson(USS.saveUrl, { method: 'POST', body: JSON.stringify(payload) })
      .then(function (d) {
        showStatus($('uss-conn-status'), !!d.ok, d.ok ? 'Zapisano ustawienia połączenia.' : (d.error || 'Błąd zapisu.'));
      })
      .catch(function (e) { showStatus($('uss-conn-status'), false, e.message || String(e)); });
  });

  // --- Skanowanie site/SSID do checkboxów ---
  function renderCheckList(sites) {
    var box = $('uss-check-list');
    if (!sites.length) {
      box.innerHTML = '<div class="uss-empty">Kontroler nie zwrócił żadnych site.</div>';
      return;
    }
    var html = '';
    sites.forEach(function (site) {
      html += '<div class="uss-site-block">';
      html += '<div class="uss-site-title">' + esc(site.desc) +
              ' <span class="uss-pill">' + site.num_clients + ' klientów · ' + site.num_ap + ' AP</span></div>';
      if (site.ssids.length) {
        html += '<div class="uss-ssid-list">';
        site.ssids.forEach(function (s) {
          var ssidChecked = USS.selectedSsids.length === 0 || USS.selectedSsids.indexOf(s.ssid) !== -1;
          html += '<label><input type="checkbox" class="uss-ssid-cb" data-site="' + site.name + '" data-ssid="' + esc(s.ssid) + '"' + (ssidChecked ? ' checked' : '') + '> ' +
                  esc(s.ssid) + ' (' + s.count + ')</label>';
        });
        html += '</div>';
      }
      html += '</div>';
    });
    box.innerHTML = html;
    $('uss-save-selection').style.display = 'inline-block';
  }

  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  $('uss-scan').addEventListener('click', function () {
    showStatus($('uss-conn-status'), true, 'Skanowanie…');
    ussFetchJson(USS.scanUrl).then(function (d) {
      if (!d.ok) { showStatus($('uss-conn-status'), false, d.error); return; }
      showStatus($('uss-conn-status'), true, 'Znaleziono ' + d.sites.length + ' site.');
      renderCheckList(d.sites);
    }).catch(function (e) { showStatus($('uss-conn-status'), false, e.message || String(e)); });
  });

  $('uss-save-selection').addEventListener('click', function () {
    var ssids = Array.from(document.querySelectorAll('.uss-ssid-cb:checked')).map(function (el) { return el.dataset.ssid; });
    ussFetchJson(USS.saveUrl, { method: 'POST', body: JSON.stringify({ selected_sites: [], selected_ssids: ssids, csrf_token: USS.csrfToken }) })
      .then(function (d) {
        showStatus($('uss-conn-status'), !!d.ok, d.ok ? 'Zapisano wybór site/SSID.' : (d.error || 'Błąd zapisu.'));
        if (d.ok) { USS.selectedSites = []; USS.selectedSsids = ssids; }
      })
      .catch(function (e) { showStatus($('uss-conn-status'), false, e.message || String(e)); });
  });

})();
</script>
