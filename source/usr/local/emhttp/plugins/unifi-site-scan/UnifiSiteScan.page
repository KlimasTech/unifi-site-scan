<?php
$plugin = "unifi-site-scan";
$cfgFile = "/boot/config/plugins/$plugin/$plugin.cfg";
$cfg = [
    'HOST' => '', 'PORT' => '8443', 'USERNAME' => '', 'PASSWORD' => '',
    'APIKEY' => '', 'SELECTED_SITES' => '', 'SELECTED_SSIDS' => '',
];
if (file_exists($cfgFile)) {
    $parsed = parse_ini_file($cfgFile);
    if (is_array($parsed)) {
        $cfg = array_merge($cfg, $parsed);
    }
}
$selectedSites = array_filter(explode(',', $cfg['SELECTED_SITES']));
$selectedSsids = array_filter(explode(',', $cfg['SELECTED_SSIDS']));
$varIni = @parse_ini_file('/var/local/emhttp/var.ini');
$csrfToken = is_array($varIni) ? ($varIni['csrf_token'] ?? '') : '';
