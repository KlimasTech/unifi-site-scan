<script>
(function () {
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  // wstrzyknij naszą tbody do wspólnej tabeli dashboardu (ten sam kontener co kafelki systemowe),
  // zamiast renderowac sie jako osobny blok na cala szerokosc strony
  function mountTile() {
    if (document.getElementById('uss-native-tbody')) { return true; }
    var box = document.getElementById('db_box1') || document.querySelector('table.dashboard');
    if (!box) { return false; }
    var tpl = document.getElementById('uss-template');
    box.insertAdjacentHTML('beforeend', tpl.innerHTML.trim());
    return true;
  }

  window.ussTileRefresh = function () {
    var body = document.getElementById('uss-tile-body');
    var sub = document.getElementById('uss-tile-subtitle');
    if (!body || !sub) { return; }
    body.innerHTML = '<div class="uss-tile-empty">Odświeżanie…</div>';
    fetch('/plugins/unifi-site-scan/scripts/scan.php?filtered=1')
      .then(function (r) {
        return r.text().then(function (text) {
          if (!text) { throw new Error('Pusta odpowiedź (HTTP ' + r.status + ') — sesja WebGUI mogła wygasnąć.'); }
          try { return JSON.parse(text); }
          catch (e) { throw new Error('Nieprawidłowa odpowiedź (HTTP ' + r.status + ')'); }
        });
      })
      .then(function (d) {
        if (!d.ok) {
          sub.textContent = 'Błąd';
          sub.className = 'uss-subtitle red-text';
          body.innerHTML = '<div class="uss-tile-error">' + esc(d.error) + '</div>';
          return;
        }
        var totalClients = 0, totalAp = 0, ssidTotals = {};
        d.sites.forEach(function (s) {
          totalAp += s.num_ap;
          s.ssids.forEach(function (ss) {
            totalClients += ss.count;
            ssidTotals[ss.ssid] = (ssidTotals[ss.ssid] || 0) + ss.count;
          });
        });
        sub.textContent = d.sites.length + ' site · ' + totalClients + ' klientów';
        sub.className = 'uss-subtitle green-text';

        var html = '<div class="uss-tile-stats">' +
          '<div class="uss-tile-stat"><div class="num">' + d.sites.length + '</div><div class="lbl">Site</div></div>' +
          '<div class="uss-tile-stat"><div class="num">' + totalAp + '</div><div class="lbl">AP</div></div>' +
          '<div class="uss-tile-stat"><div class="num">' + totalClients + '</div><div class="lbl">Klienci</div></div>' +
          '</div>';
        var ssidKeys = Object.keys(ssidTotals);
        if (ssidKeys.length) {
          html += '<div class="uss-tile-ssids">';
          ssidKeys.forEach(function (ssid) {
            html += '<span class="uss-tile-ssid-pill">' + esc(ssid) + ' <b>' + ssidTotals[ssid] + '</b></span>';
          });
          html += '</div>';
        }
        body.innerHTML = html;
      })
      .catch(function (e) {
        sub.textContent = 'Błąd';
        sub.className = 'uss-subtitle red-text';
        body.innerHTML = '<div class="uss-tile-error">' + esc(e.message || String(e)) + '</div>';
      });
  };

  function init() {
    if (!mountTile()) {
      // tabela dashboardu moze jeszcze nie istnieć w DOM - sprobuj ponownie za chwile
      setTimeout(init, 300);
      return;
    }
    ussTileRefresh();
    setInterval(ussTileRefresh, 60000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
